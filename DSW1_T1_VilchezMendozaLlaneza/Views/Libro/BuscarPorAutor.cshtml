@model IEnumerable<DSW1_T1_VilchezMendozaLlaneza.Models.Libro>

@{
    ViewData["Title"] = "Buscar Libros por Autor";
    string autorBuscado = ViewBag.Autor as string ?? "";
    int totalResultados = Model.Count();
}

<div class="container py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">
            Gestión de biblioteca
        </span>

        <h1 class="fw-bold mb-2">
            Buscar libros por autor
        </h1>

        <p class="text-muted mb-0">
            Encuentra los libros registrados en la biblioteca
            utilizando el nombre completo o parcial del autor.
        </p>
    </div>

    <!-- TARJETA DEL BUSCADOR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Buscar en el catálogo
            </h5>

            <form asp-controller="Libro"
                  asp-action="BuscarPorAutor"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-8">

                        <label for="autor"
                               class="form-label fw-semibold">
                            Nombre del autor
                        </label>

                        <input type="text"
                               id="autor"
                               name="autor"
                               value="@autorBuscado"
                               class="form-control form-control-lg"
                               placeholder="Ej. Gabriel García Márquez"
                               maxlength="100"
                               autocomplete="off" />

                        <div class="form-text">
                            Puedes ingresar solamente una parte
                            del nombre o apellido.
                        </div>

                    </div>

                    <div class="col-lg-4">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-lg flex-fill">
                                Buscar
                            </button>

                            <a asp-controller="Libro"
                               asp-action="BuscarPorAutor"
                               class="btn btn-outline-secondary btn-lg">
                                Limpiar
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- TARJETA DE RESULTADOS -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 p-4 pb-3">

            <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3">

                <div>
                    <h5 class="fw-bold mb-1">
                        Resultados de búsqueda
                    </h5>

                    <p class="text-muted small mb-0">
                        Libros disponibles en el catálogo
                    </p>
                </div>

                <span class="badge bg-primary-subtle text-primary
                    rounded-pill px-3 py-2">
                    @totalResultados libro(s)
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Nombre del libro</th>
                                <th>Autor</th>
                                <th>Editorial</th>
                                <th>ISDN</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var libro in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-light
                                            text-dark border">
                                            #@libro.Id
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @libro.NombreLibro
                                        </span>
                                    </td>

                                    <td>
                                        @libro.Autor
                                    </td>

                                    <td class="text-muted">
                                        @libro.NombreEditorial
                                    </td>

                                    <td>
                                        <span class="font-monospace small">
                                            @libro.ISDN
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- MENSAJE SIN RESULTADOS -->
                <div class="text-center px-4 py-5">

                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center
                            justify-content-center rounded-circle
                            bg-light"
                              style="width:70px; height:70px;
                            font-size:30px;">
                            &#128269;
                        </span>
                    </div>

                    <h5 class="fw-bold mb-2">
                        No se encontraron libros
                    </h5>

                    <p class="text-muted mb-3">
                        No existen coincidencias para el autor ingresado.
                        Intenta utilizar otro nombre o apellido.
                    </p>

                    <a asp-action="BuscarPorAutor"
                       class="btn btn-outline-primary">
                        Mostrar todos los libros
                    </a>

                </div>
            }

        </div>

        <div class="card-footer bg-white border-0 p-4">

            <a asp-controller="Libro"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Volver al listado
            </a>

        </div>

    </div>

</div>
